{
	"name": "pi-free-provider",
	"version": "0.2.0",
	"description": "pi extension exposing Cline's free models and OpenCode Zen's free tier as auto-synced providers",
	"author": "kslamph",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"cline",
		"opencode",
		"zen",
		"free-models",
		"provider"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kslamph/pi-free-provider.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"index.ts",
		"sources",
		"!sources/**/*.test.ts",
		"github.ts",
		"contract.ts",
		"feeds.ts",
		"capabilities.ts",
		"mapping.ts",
		"registry.ts",
		"auth.ts",
		"state.ts",
		"stream.ts",
		"tui.ts",
		"sidecar.ts",
		"zen-sidecar.ts",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.87.1",
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@types/node": "^25.0.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}
